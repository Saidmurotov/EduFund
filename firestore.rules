rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Foydalanuvchi tizimga kirganini tekshirish funksiyasi
    function isSignedIn() { return request.auth != null; }

    // Foydalanuvchi profillari
    match /userProfiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Grantlar (Hamma o'qiy oladi)
    match /grants/{grantId} {
      allow read: if true;
      allow write: if isSignedIn(); 
    }

    // Taqvim va Vazifalar (Upcoming Tasks uchun)
    match /calendarEvents/{eventId} {
      allow read, write: if isSignedIn() && (
        resource == null || resource.data.userId == request.auth.uid
      );
    }

    // Boshqa barcha kolleksiyalarga umumiy xavfsiz ruxsat
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
