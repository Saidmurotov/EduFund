rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin check:
    // - custom claim request.auth.token.admin == true, OR
    // - users/{uid}.role == "admin"
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    // 1) users/{userId}
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update, delete: if isSelf(userId);
    }

    // 2) opportunities (grantlar)
    match /opportunities/{opportunityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "partner"
      );
      allow update, delete: if isAdmin();
    }

    // 3) savedGrants/{userId}/items/{itemId}
    match /savedGrants/{userId}/items/{itemId} {
      allow read, write: if isSelf(userId);
    }

    // 4) notifications/{userId}/items/{itemId}
    //    Faqat o'zi o'qiy oladi va isRead ni yangilay oladi
    //    Yozish faqat admin yoki backend orqali (server-side)
    match /notifications/{userId}/items/{itemId} {
      allow read: if isSelf(userId);
      allow update: if isSelf(userId);
      allow create, delete: if isAdmin();
    }

    // 5) userCalendars/{userId}/plans/{planId}
    //    Faqat o'zi o'qiy va yoza oladi
    match /userCalendars/{userId}/plans/{planId} {
      allow read, write: if isSelf(userId);
    }

    // 6) paymentIntents — foydalanuvchi yaratadi, admin o'qiydi
    match /paymentIntents/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // 7) verificationLogs
    match /verificationLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 8) Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

