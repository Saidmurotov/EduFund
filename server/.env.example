PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Gemini API key
GOOGLE_API_KEY=your_gemini_api_key_here

# Firebase Web API key (mobile/backend email-password login uchun)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Firebase Admin service account (JSON string) yoki GOOGLE_APPLICATION_CREDENTIALS yo'li
FIREBASE_SERVICE_ACCOUNT={"project_id":"...", "client_email":"...", "private_key":"..."}
# yoki:
# GOOGLE_APPLICATION_CREDENTIALS=C:\\absolute\\path\\to\\serviceAccountKey.json

